<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v4 package for the Dataverse GW (per-user MSI, no admin required).
  Build with dist/build-msi.ps1 (installs the WiX .NET tool if missing).
  The published app folder is harvested via the <Files> element (bindpath 'pub').
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Dataverse GW"
           Manufacturer="$(var.Manufacturer)"
           Version="$(var.Version)"
           UpgradeCode="0e5654a7-e4ad-44ab-892c-961dd83e2987"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Install under the user's local AppData\Programs (per-user, no elevation). -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="DataverseGW" />
      </Directory>
    </StandardDirectory>

    <!-- Start Menu shortcut. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="Dataverse GW" />
    </StandardDirectory>

    <!-- Published files (self-contained single-file publish emits exactly these).
         If the publish output changes, add matching <Component>/<File> entries. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Bitness="always64">
        <File Id="MainExe" Source="!(bindpath.pub)\DataverseGW.exe" KeyPath="yes" />
      </Component>
      <Component Bitness="always64">
        <File Source="!(bindpath.pub)\DataverseGW.staticwebassets.endpoints.json" />
      </Component>
      <Component Bitness="always64">
        <File Source="!(bindpath.pub)\web.config" />
      </Component>
    </ComponentGroup>

    <!-- Shortcut + per-user registry keypath. -->
    <Component Id="AppShortcut" Directory="AppShortcutFolder" Guid="*">
      <Shortcut Id="StartMenuShortcut"
                Name="Dataverse GW"
                Target="[INSTALLFOLDER]DataverseGW.exe"
                WorkingDirectory="INSTALLFOLDER"
                Description="Dataverse GW (Arrow Flight SQL, localhost:32010)" />
      <RemoveFolder Id="RemoveAppShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\DataverseGW"
                     Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Dataverse GW" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AppShortcut" />
    </Feature>
  </Package>
</Wix>
