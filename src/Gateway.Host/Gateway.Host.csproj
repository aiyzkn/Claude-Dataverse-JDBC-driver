<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gateway.Host</RootNamespace>
    <!-- 配布(2.7.1): 実行ファイル名。バージョン・製品名等は src/Directory.Build.props で一元管理(4.x 配布) -->
    <AssemblyName>DataverseGW</AssemblyName>
    <Description>Microsoft Dataverse 用 SQL ドライバ(Arrow Flight SQL ゲートウェイ)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" /><!-- 3.1.3 dvload: Excel(.xlsx) 読み取り -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" /><!-- 4.2.2a 常駐サービス化 -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gateway.Core\Gateway.Core.csproj" />
    <ProjectReference Include="..\Gateway.Dataverse\Gateway.Dataverse.csproj" />
    <ProjectReference Include="..\Gateway.Flight\Gateway.Flight.csproj" />
  </ItemGroup>
</Project>
